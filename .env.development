# 页面标题
VUE_APP_TITLE = 数采平台

# 开发环境配置
ENV = 'development'

# LabDataHub/开发环境
VUE_APP_BASE_API = '/dev-hub-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# WebSocket 跟随页面地址经 devServer /ws 代理转发到后端，无需配置；若需直连后端可在此填 ws://<后端ip>:<端口>
VUE_APP_WS_BASE_URL=

# 高德地图 JS API 2.0 Key（开发环境）
VUE_APP_AMAP_KEY=7d73c82701be48fb9e93537abc34c846

# 高德地图安全密钥（对应 key 的 securityJsCode）
VUE_APP_AMAP_SECURITY_JS_CODE=ba4805568149092ba56a9ea8f6e5e90e
