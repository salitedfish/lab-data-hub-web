# 页面标题
VUE_APP_TITLE = LabDataHub

# 生产环境配置
ENV = 'production'

# LabDataHub/生产环境
VUE_APP_BASE_API = '/prod-hub-api'

# 实时数据 WebSocket（设备详情 / 组件调试）跟随页面地址 ws(s)://<页面主机>/<前缀>/<type>/<id>。
# 生产对外用 /prod-hub-ws/ 暴露（避开过于通用的 /ws），nginx 需把它转到后端的 /ws/：
#   location /prod-hub-ws/ { proxy_pass http://127.0.0.1:8085/ws/; ...(Upgrade 头 + 放大 proxy_read_timeout) }
# 参考配置见 文档/部署-nginx反向代理示例.conf。**不配代理的话页面其它功能全正常、只有实时数据不刷新。**
# 留空则用默认前缀 /ws（开发环境即如此，由 vue.config.js 的 devServer 代理）。
VUE_APP_WS_PATH_PREFIX = /prod-hub-ws

# 直连后端时填完整 WS 地址（如 ws://192.168.1.10:8085），留空则跟随页面地址（推荐，见上）。
VUE_APP_WS_BASE_URL=

# 高德地图 JS API 2.0 Key（开发环境）
VUE_APP_AMAP_KEY=7d73c82701be48fb9e93537abc34c846

# 高德地图安全密钥（对应 key 的 securityJsCode）
VUE_APP_AMAP_SECURITY_JS_CODE=ba4805568149092ba56a9ea8f6e5e90e
